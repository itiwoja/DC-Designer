{
  "name": "dc-designer",
  "version": "1.0.0",
  "description": "ポスターを「レイヤーを重ねた設計図（JSON）」として AI に組み立てさせ、エディタで調整して SVG / PNG / PPTX に書き出すツール",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itiwoja/DC-Designer.git"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"node scripts/wait-for-api.mjs && vite\" \"CHOKIDAR_USEPOLLING=1 tsx watch server/index.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jszip": "^3.10.1",
    "openai": "^7.39.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
