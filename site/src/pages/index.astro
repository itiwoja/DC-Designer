---
import "../styles/home.css";
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";
import Shape from "../components/Shape.astro";
import DownloadButton from "../components/DownloadButton.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Reveal from "../components/Reveal.astro";
import Requirements from "../components/Requirements.astro";
import { getCollection, getEntry } from "astro:content";

const features = (await getCollection("features")).filter((f) => f.data.exeAvailable).sort((a, b) => a.data.order - b.data.order);
// SEC-001-02 主要 3 枚（● 朱 → ▲ 山吹 → ■ 群青）。残りは SEC-001-03 に order 順
const majorOrder = [
  { id: "ai-layout", shape: "circle" },
  { id: "layer-editor", shape: "triangle" },
  { id: "export", shape: "square" },
] as const;
const majors = majorOrder.flatMap(({ id, shape }) => {
  const feature = features.find((f) => f.id === id);
  return feature ? [{ feature, shape }] : [];
});
const minors = features.filter((f) => !majorOrder.some((m) => m.id === f.id));

const home = await getEntry("pages", "home");
// home.md の本文：最初の段落がキャッチ、残りが説明
const [catchCopy, ...rest] = (home?.body ?? "").trim().split(/\n\s*\n/);
---
<Base title="ポスターを、AIの下書きからレイヤーで仕上げる" description="DC-Designer は、AI が作った下書きをレイヤーで自分の手で仕上げられるポスター作成アプリ（Windows 版）です。無料・MIT ライセンス。">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__text">
        <h1 id="hero-title">{catchCopy}</h1>
        {rest.length > 0 && <p class="hero__lead">{rest.join(" ")}</p>}
        <DownloadButton large />
      </div>
      <div class="hero__visual">
        <Media mediaId="hero" kind="hero" loading="eager" sizes="(min-width: 1024px) 560px, (min-width: 768px) 700px, 100vw" />
        <Shape shape="circle" size="hero" class="hero__shape hero__shape--circle" />
        <Shape shape="triangle" size="hero" class="hero__shape hero__shape--triangle" />
        <Shape shape="square" size="hero" class="hero__shape hero__shape--square" />
      </div>
    </section>

    <section class="section home-section" id="features" aria-labelledby="features-title">
      <h2 id="features-title" class="heading-mark"><Shape shape="circle" />下書きから仕上げまで</h2>
      <ul class="feature-list feature-list--major">
        {majors.map(({ feature, shape }) => (
          <FeatureCard feature={feature} variant="major" shape={shape} sizes="(min-width: 1024px) 340px, (min-width: 768px) 360px, 100vw" />
        ))}
      </ul>
    </section>
  </div>

  <section class="home-band-white" aria-labelledby="more-title">
    <div class="container section">
      <h2 id="more-title" class="heading-mark"><Shape shape="triangle" />ほかにもできること</h2>
      <ul class="feature-list feature-list--minor">
        {minors.map((f) => <FeatureCard feature={f} variant="minor" sizes="(min-width: 768px) 160px, 112px" />)}
      </ul>
    </div>
  </section>

  <div class="container">
    <section class="section home-section" aria-labelledby="demo-title">
      <h2 id="demo-title" class="heading-mark"><Shape shape="square" />デモ</h2>
      <div class="media-frame"><Media mediaId="demo" kind="demo" sizes="(min-width: 1152px) 1056px, 100vw" /></div>
    </section>

    <section class="section home-section" aria-labelledby="req-title">
      <h2 id="req-title" class="heading-mark"><Shape shape="circle" />動作要件</h2>
      <Requirements />
    </section>
  </div>

  <section class="cta-band" aria-labelledby="band-title">
    <div class="container cta-band__inner">
      <Shape shape="triangle" size="hero" class="cta-band__shape" />
      <h2 id="band-title" class="cta-band__title">ダサいスライドとはもうおさらば。</h2>
      <DownloadButton large variant="band" />
    </div>
  </section>
  <Reveal />
</Base>
