---
import Base from "../../layouts/Base.astro";
import { getPolicy } from "../../lib/policies";
import { formatDateJa } from "../../lib/format";
import "../../styles/policy.css";

const policy = await getPolicy("privacy");
---
<Base title={policy.title} description="DC-Designer のプライバシーです。">
  <div class="container section">
    <article class="prose">
      <h1>{policy.title}</h1>
      {policy.updatedAt && <p class="policy__updated">最終更新：{formatDateJa(policy.updatedAt)}</p>}
      <div class="policy__body" set:html={policy.bodyHtml} />
    </article>
  </div>
</Base>
