# 画像生成の既定（openai | gemini | comfyui | codex | placeholder）。キーを両方入れればエディタ上で切り替えられる
# 指定したプロバイダが使えない場合は、OpenAI → Gemini → COMFYUI_URL を指定していれば ComfyUI → placeholder（ダミー画像）の順に自動で切り替わる
# ComfyUI・Codex は接続・ログインを事前に確認しないため、選ばれたあとに失敗するとエラーになる
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# gpt-image-2.5-flare（速い・既定）| gpt-image-2.5-sunburst（編集精度重視）
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max | auto
OPENAI_IMAGE_QUALITY=medium

# Gemini（https://aistudio.google.com/apikey で発行）
GEMINI_API_KEY=
# gemini-3.1-flash-image（既定）| gemini-3.1-flash-lite-image（速い・安い）| gemini-3-pro-image（高品質）
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 512px | 1K | 2K | 4K（lite は 1K のみ）
GEMINI_IMAGE_SIZE=1K

# ローカル生成: ComfyUI（https://github.com/comfyanonymous/ComfyUI）の API を使う。常に選択肢に出る（既定 http://127.0.0.1:8188）
# Windows 側で動かす場合、WSL からは 127.0.0.1 で届かないことがある（mirrored ネットワークでなければ
# Windows のホスト IP を指定し、ComfyUI を --listen 0.0.0.0 で起動する）
# COMFYUI_URL=http://127.0.0.1:8188
# models/checkpoints 内のファイル名。未指定なら最初に見つかったものを使う（既定ワークフローは SDXL 系向け）
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_STEPS=25
# COMFYUI_CFG=6
# COMFYUI_SAMPLER=dpmpp_2m
# COMFYUI_SCHEDULER=karras
# COMFYUI_NEGATIVE=text, watermark, lowres, blurry
# Flux など別構成のときは API 形式で書き出したワークフロー JSON を指定。
# {{prompt}} {{negative}} {{width}} {{height}} {{seed}} が置き換わる
# COMFYUI_WORKFLOW=./comfy-workflow.json
# COMFYUI_TIMEOUT_MS=600000

# 実験的: IMAGE_PROVIDER=codex で Codex CLI の image_gen を使う。自分用のみ。
# アプリ内のサインインとは別に、CLI 側で `codex login`（ChatGPT ログイン）が必要。ChatGPT プランの枠を消費する
# Codex CLI 0.160.1 以降なら WSL でも動作確認済み（それ以前は openai/codex#19133 で image_gen が出ない）。1 枚 40〜60 秒ほど
# nvm 環境では PATH に無いことがあるのでフルパス指定を推奨
# CODEX_BIN=/home/<you>/.nvm/versions/node/<ver>/bin/codex
# CODEX_TIMEOUT_MS=300000
# 停止要求（SIGTERM）から強制終了（SIGKILL）までの猶予（ミリ秒）
# CODEX_KILL_GRACE_MS=5000
# キュー待ちを含む 1 回の画像生成の期限（ミリ秒）
# CODEX_DEADLINE_MS=900000

# Sign in with ChatGPT。レイアウト生成・修正は ChatGPT プランで行う（エディタ左下の「ChatGPTでログイン」からサインイン）
# 未指定ならアカウントで使えるモデル一覧の先頭を使う（AI の設定画面でモデルを選ぶとそちらが優先）
CHATGPT_MODEL=
# 資格情報の保存先（既定: ~/.config/dc-designer）
# DC_DESIGNER_CONFIG_DIR=

# OpenRouter（https://openrouter.ai/keys で発行）。キーを入れると ChatGPT にサインインしなくてもレイアウト生成・AI 修正・フォント提案が使える（OpenRouter のクレジットを消費する）
OPENROUTER_API_KEY=
# 自動のときのモデル。画像を読めるモデルを指定する（参考画像の再現で画像を渡す）。一覧: https://openrouter.ai/models
# AI の設定・チャット欄でモデルを選ぶとそちらが優先（画像を読めるモデルだけが一覧に出る）
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# 出力の上限トークン数（未指定ならモデル側の既定）。長いレイアウトが途中で切れるときに増やす
# OPENROUTER_MAX_TOKENS=32000
# レイアウト生成・AI 修正に使う AI（chatgpt | openrouter）。未指定なら ChatGPT プランが使えれば ChatGPT、無ければ OpenRouter
# 指定した AI が使えないときは切り替えずにエラーにする。エディタ左下の歯車 → AI の設定で選ぶとそちらが優先
AI_PROVIDER=

API_PORT=8787
